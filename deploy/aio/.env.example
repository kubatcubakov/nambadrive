# NambaDrive Phase 1 All-in-One
COMPOSE_PROJECT_NAME=nambadrive

NAMBADRIVE_APP_ENV=development
NAMBADRIVE_PUBLIC_URL=http://localhost:8080
NAMBADRIVE_DATABASE_URL=postgresql+asyncpg://nambadrive:CHANGE_ME_DB@postgres:5432/nambadrive
NAMBADRIVE_REDIS_URL=redis://redis:6379/0
NAMBADRIVE_AUDIT_LOG_PATH=/var/log/nambadrive/audit.json
NAMBADRIVE_CSRF_SECRET=CHANGE_ME_LONG_RANDOM_CSRF_SECRET

# Authentik OIDC provider. Default Authentik per-provider issuer format:
# https://auth.example.com/application/o/nambadrive/
NAMBADRIVE_OIDC_ISSUER=https://auth.example.com/application/o/nambadrive/
NAMBADRIVE_OIDC_DISCOVERY_URL=https://auth.example.com/application/o/nambadrive/.well-known/openid-configuration
NAMBADRIVE_OIDC_CLIENT_ID=nambadrive
NAMBADRIVE_OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
NAMBADRIVE_OIDC_ALLOWED_ALGORITHMS=["RS256"]
NAMBADRIVE_OIDC_TRANSACTION_TTL_SECONDS=600
NAMBADRIVE_OIDC_CLOCK_SKEW_SECONDS=60

# DEV over HTTP: false. Production HTTPS: true.
NAMBADRIVE_COOKIE_SECURE=false
NAMBADRIVE_SESSION_TTL_SECONDS=28800

POSTGRES_DB=nambadrive
POSTGRES_USER=nambadrive
POSTGRES_PASSWORD=CHANGE_ME_DB

HTTP_PORT=8080
