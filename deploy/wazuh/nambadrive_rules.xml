<group name="nambadrive,">
  <rule id="110000" level="3">
    <decoded_as>json</decoded_as>
    <field name="application">^nambadrive$</field>
    <description>NambaDrive audit event</description>
  </rule>
  <rule id="110001" level="12">
    <if_sid>110000</if_sid><field name="event_type">^malware_detected$</field>
    <description>NambaDrive malware quarantined</description><group>malware,</group>
  </rule>
  <rule id="110002" level="12">
    <if_sid>110000</if_sid><field name="event_type">^admin_breakglass$</field>
    <description>NambaDrive emergency access issued</description><group>access_control,</group>
  </rule>
  <rule id="110003" level="8">
    <if_sid>110000</if_sid><field name="event_type">^change_acl$</field>
    <description>NambaDrive ACL changed</description><group>access_control,</group>
  </rule>
  <rule id="110004" level="8">
    <if_sid>110000</if_sid><field name="event_type" type="pcre2">^(legal_hold_enabled|legal_hold_disabled|retention_changed|classification_changed|ownership_changed|department_manager_changed)$</field>
    <description>NambaDrive security governance changed</description><group>access_control,</group>
  </rule>
  <rule id="110005" level="5">
    <if_sid>110000</if_sid><field name="event_type">^quota_exceeded$</field>
    <description>NambaDrive storage allocation denied</description>
  </rule>
  <rule id="110006" level="5">
    <if_sid>110000</if_sid><field name="event_type">^login_failed$</field>
    <description>NambaDrive authentication failed</description><group>authentication_failed,</group>
  </rule>
  <rule id="110007" level="10" frequency="10" timeframe="60">
    <if_matched_sid>110006</if_matched_sid><same_field>ip</same_field>
    <description>NambaDrive repeated login failures from one client</description>
  </rule>
  <rule id="110010" level="5">
    <if_sid>110000</if_sid><field name="event_type">^access_denied$</field><field name="result">^denied$</field>
    <description>NambaDrive access denied</description><group>access_control,</group>
  </rule>
  <rule id="110011" level="10" frequency="10" timeframe="60">
    <if_matched_sid>110010</if_matched_sid><same_field>ip</same_field>
    <description>NambaDrive repeated access denials from one client</description>
  </rule>
  <rule id="110012" level="3">
    <if_sid>110000</if_sid><field name="event_type">^download$</field>
    <description>NambaDrive download or delegated editor capability</description>
  </rule>
  <rule id="110013" level="10" frequency="30" timeframe="60">
    <if_matched_sid>110012</if_matched_sid><same_field>user</same_field>
    <description>NambaDrive high download activity by one user</description>
  </rule>
  <rule id="110014" level="8">
    <if_sid>110000</if_sid><field name="event_type" type="pcre2">^(purge_started|purge_completed|quarantine_duplicate_removed)$</field>
    <description>NambaDrive governed physical cleanup</description>
  </rule>
</group>
