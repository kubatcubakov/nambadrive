# Public/non-secret topology only. Real credentials go in private mounted files.
PUBLIC_IP=127.0.0.1
PRIVATE_IP=127.0.0.1
APP_DOMAIN=drive.example.com
OFFICE_DOMAIN=office.example.com
SCIM_DOMAIN=scim.internal.example.com
BACKCHANNEL_DOMAIN=office-callback.internal.example.com
AUTHENTIK_CIDR=10.40.0.10/32
APP_PRIVATE_ADDRESS=10.40.0.11
OFFICE_CIDR=172.29.0.20/32
S3_DOMAIN=s3.internal.example.com
SEARCH_HOST=search.internal.example.com
SEARCH_USERNAME=nambadrive-indexer
OIDC_ISSUER=https://auth.example.com/application/o/nambadrive/
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/nambadrive/.well-known/openid-configuration
OIDC_CLIENT_ID=nambadrive
OFFICE_INTERNAL_URL=http://onlyoffice
OFFICE_BACKEND_URL=https://office-callback.internal.example.com:8444
MASTER_PEERS=10.40.0.31:9333,10.40.0.32:9333,10.40.0.12:9333
# All directories/files below must be provisioned with correct service ownership.
SETTINGS_DIR=/srv/nambadrive/private/settings
AUDIT_DIR=/srv/nambadrive/audit
TRUST_DIR=/srv/nambadrive/public-trust
TLS_DIR=/srv/nambadrive/private/gateway-tls
DB_TLS_DIR=/srv/nambadrive/private/database-tls
SEARCH_TLS_DIR=/srv/nambadrive/private/search-tls
WEED_TLS_DIR=/srv/nambadrive/private/weed-tls
WEED_SECURITY_FILE=/srv/nambadrive/private/security.toml
S3_CONFIG_FILE=/srv/nambadrive/private/s3.json
DATABASE_PASSWORD_FILE=/srv/nambadrive/private/database_password
OPENSEARCH_CONFIG_FILE=/srv/nambadrive/private/opensearch.yml
SEARCH_SECURITY_DIR=/srv/nambadrive/private/search-security
OFFICE_CONFIG_FILE=/srv/nambadrive/private/office-local.json
INDEPENDENT_WAL_DIR=/mnt/independent-encrypted-wal/nambadrive-cluster
