limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=share_limit:10m rate=10r/s;
server {
    listen 8080;
    server_name ${APP_DOMAIN};
    access_log off;
    return 308 https://${APP_DOMAIN}$request_uri;
}
server {
    listen 8443 ssl;
    server_name ${APP_DOMAIN};
    ssl_certificate /tls/server.crt;
    ssl_certificate_key /tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    client_max_body_size 501m;
    client_body_timeout 120s;
    proxy_read_timeout 180s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://${OFFICE_DOMAIN}; frame-src https://${OFFICE_DOMAIN}; connect-src 'self'; img-src 'self' blob: data:; style-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location ^~ /scim/ { return 404; }
    location ^~ /api/v1/office/internal/ { return 404; }
    location = /api/v1/auth/login {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy-private.conf;
    }
    location = /api/v1/shares/access {
        limit_req zone=share_limit burst=20 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy-private.conf;
    }
    location /api/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy-private.conf;
    }
    location / {
        proxy_pass http://frontend:8080;
        include /etc/nginx/proxy-private.conf;
    }
}
