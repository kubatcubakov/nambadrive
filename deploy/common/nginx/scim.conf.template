server {
    listen 9443 ssl;
    server_name ${SCIM_DOMAIN};
    ssl_certificate /tls/server.crt;
    ssl_certificate_key /tls/server.key;
    ssl_client_certificate /tls/provisioning-ca.crt;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    server_tokens off;
    client_max_body_size 64k;
    allow ${AUTHENTIK_CIDR};
    deny all;
    location ^~ /scim/v2/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy-private.conf;
    }
    location / { return 404; }
}
