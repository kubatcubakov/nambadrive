server {
    listen 8444 ssl;
    server_name ${BACKCHANNEL_DOMAIN};
    ssl_certificate /tls/server.crt;
    ssl_certificate_key /tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    client_max_body_size 501m;
    allow ${OFFICE_CIDR};
    deny all;
    location ^~ /api/v1/office/internal/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy-private.conf;
    }
    location / { return 404; }
}
