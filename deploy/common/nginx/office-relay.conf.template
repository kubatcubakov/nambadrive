# Editor has no direct egress; only this fixed-origin relay reaches the app node.
server {
    listen 8444 ssl;
    server_name ${BACKCHANNEL_DOMAIN};
    ssl_certificate /tls/server.crt;
    ssl_certificate_key /tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    server_tokens off;
    client_max_body_size 501m;
    location ^~ /api/v1/office/internal/ {
        proxy_pass https://${APP_PRIVATE_ADDRESS}:8444;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKCHANNEL_DOMAIN};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /trust/ca-bundle.crt;
        proxy_set_header Host ${BACKCHANNEL_DOMAIN};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
    location / { return 404; }
}
